<launch>
  <node pkg="agnocast_image_test" exec="rgba_publisher_zero_node" name="rgba_publisher_zero_node" output="screen">
    <env name="LD_PRELOAD" value="libagnocast_heaphook.so:$(env LD_PRELOAD '')" />
    <env name="MEMPOOL_SIZE" value="67108864" />  <!-- 64MB-->
    <arg name="image_topic" value="/camera/image_raw" />
  </node>

  <node_container pkg="agnocastlib" exec="agnocast_component_container" name="listener_container" namespace="" output="screen">
    <env name="LD_PRELOAD" value="libagnocast_heaphook.so:$(env LD_PRELOAD '')" />
    <env name="MEMPOOL_SIZE" value="16777216" /> <!-- 16MB-->

    <composable_node pkg="agnocast_image_test" plugin="zero::ImageViewerNode" name="rgba_show_zero_node" namespace="">
      <arg name="image_topic" value="/camera/image_raw" />
    </composable_node>
  </node_container>
</launch>
