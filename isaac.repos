repositories:
  # core
  core/isaac_ros_examples:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_examples.git
    version: v3.1.0
  core/isaac_ros_nitros:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nitros.git
    version: v3.1.0
  core/isaac_ros_common:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_common.git
    version: v3.1.0
  # image_pipeline
  image_pipeline/isaac_ros_compression:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_compression.git
    version: v3.1.0
  image_pipeline/isaac_ros_argus_camera:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_argus_camera.git
    version: v3.1.0
  image_pipeline/isaac_ros_v4l2_camera:
    type: git
    url: https://github.com/pixmoving-moveit/isaac_ros_v4l2_camera.git
    version: main

